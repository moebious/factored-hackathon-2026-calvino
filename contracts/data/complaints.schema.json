  "required": [
    "complaint_id",
    "customer_id"
  ],
  "title": "complaints",
  "type": "object",
  "x-calvino": {
    "primary_key": [
      "complaint_id"
    ],
    "required_columns": [
      "complaint_id",
      "customer_id"
    ],
    "foreign_keys": [
      {
        "column": "customer_id",
        "references": "customers.customer_id",
        "severity": "error"
      }
    ],
    "rules": [
      {
        "id": "CP-AMOUNT-NO-CURRENCY",
        "severity": "known_defect",
        "violation": "claimed_amount IS NOT NULL AND currency IS NULL",
        "meaning": "a claimed amount without a currency cannot be converted to USD"
      },
      {
        "id": "CP-ORIGIN-NULL",
        "severity": "known_defect",
        "violation": "origin_interaction_id IS NULL",
        "meaning": "no complaint records its originating interaction; link by customer and time"
      }
    ]
  }
}
