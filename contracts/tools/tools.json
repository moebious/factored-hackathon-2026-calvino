        },
        "reason": {
          "description": "Case/Rsn",
          "title": "Reason",
          "type": "string"
        },
        "rejection_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CxlStsRspn/RsnCd",
          "title": "Rejection Reason"
        },
        "requested_by": {
          "description": "Assgnr: the customer who asked",
          "title": "Requested By",
          "type": "string"
        },
        "simulated": {
          "description": "True when the adapter did not move real money",
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "original_reference",
        "reason",
        "requested_by",
        "outcome",
        "simulated",
        "message"
      ],
      "title": "CancellationResponse",
      "type": "object"
    }
  },
