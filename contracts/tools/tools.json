[
  {
    "description": "The signed-in customer: name, country, segment and number of accounts.",
    "input_schema": {
      "properties": {},
      "title": "get_customer_summaryArguments",
      "type": "object"
    },
    "kind": "read",
    "name": "get_customer_summary",
    "output_schema": {
      "additionalProperties": false,
      "description": "The signed-in customer, as seen by the agent (no ISO message; a business-partner extract).",
      "properties": {
        "account_count": {
          "minimum": 0,
          "title": "Account Count",
          "type": "integer"
        },
        "country": {
          "description": "ISO 3166-1 alpha-2 country",
          "pattern": "^[A-Z]{2}$",
          "title": "Country",
          "type": "string"
        },
        "customer_id": {
          "title": "Customer Id",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "segment": {
          "title": "Segment",
          "type": "string"
        }
      },
      "required": [
        "customer_id",
        "display_name",
        "country",
        "segment",
        "account_count"
      ],
      "title": "CustomerSummary",
      "type": "object"
    }
  },
  {
    "description": "The signed-in customer's accounts.",
    "input_schema": {
      "properties": {},
      "title": "list_accountsArguments",
      "type": "object"
    },
    "kind": "read",
    "name": "list_accounts",
    "output_schema": {
      "$defs": {
        "Account": {
          "additionalProperties": false,
          "description": "A cash account (camt.052 ``Acct``).",
          "properties": {
            "account_id": {
              "description": "Acct/Id",
              "title": "Account Id",
              "type": "string"
            },
            "account_type": {
              "description": "Acct/Tp",
              "title": "Account Type",
              "type": "string"
            },
            "balance": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,19}0*$)\\d{0,16}\\.\\d{0,2}0*$)",
                  "type": "string"
                }
              ],
              "description": "Bal/Amt",
              "title": "Balance"
            },
            "currency": {
              "description": "Acct/Ccy",
              "pattern": "^[A-Z]{3}$",
              "title": "Currency",
              "type": "string"
            },
            "status": {
              "title": "Status",
              "type": "string"
            }
          },
          "required": [
            "account_id",
            "account_type",
            "currency",
            "status",
            "balance"
          ],
          "title": "Account",
          "type": "object"
        }
      },
      "properties": {
        "result": {
          "items": {
            "$ref": "#/$defs/Account"
          },
          "title": "Result",
          "type": "array"
        }
      },
      "required": [
        "result"
      ],
      "title": "list_accountsOutput",
      "type": "object"
    }
  },
  {
    "description": "Entries on one of the customer's accounts, optionally between two booking dates.",
    "input_schema": {
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "date_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date From"
        },
        "date_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date To"
        }
      },
      "required": [
        "account_id"
      ],
      "title": "get_account_entriesArguments",
      "type": "object"
    },
    "kind": "read",
    "name": "get_account_entries",
    "output_schema": {
      "$defs": {
        "AccountEntry": {
          "additionalProperties": false,
          "description": "An account entry (camt.053 ``Ntry`` / camt.054 notification).",
          "properties": {
            "amount": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0.0,
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,19}0*$)\\d{0,16}\\.\\d{0,2}0*$)",
                  "type": "string"
                }
              ],
              "description": "Ntry/Amt",
              "title": "Amount"
            },
            "bank_transaction_code": {
              "description": "Ntry/BkTxCd (domain-family-subfamily)",
              "title": "Bank Transaction Code",
              "type": "string"
            },
            "booking_date": {
              "description": "Ntry/BookgDt",
              "format": "date",
              "title": "Booking Date",
              "type": "string"
            },
            "country": {
              "anyOf": [
                {
                  "description": "ISO 3166-1 alpha-2 country",
                  "pattern": "^[A-Z]{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Transaction country",
              "title": "Country"
            },
            "credit_debit": {
              "$ref": "#/$defs/CreditDebit",
              "description": "Ntry/CdtDbtInd"
            },
            "currency": {
              "description": "Ntry/Amt@Ccy",
              "pattern": "^[A-Z]{3}$",
              "title": "Currency",
              "type": "string"
            },
            "entry_reference": {
              "description": "Ntry/NtryRef",
              "title": "Entry Reference",
              "type": "string"
            },
            "merchant_category_code": {
              "anyOf": [
                {
                  "pattern": "^[0-9]{4}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "ISO 18245 merchant category",
              "title": "Merchant Category Code"
            },
            "remittance_information": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Ntry/NtryDtls/TxDtls/RmtInf/Ustrd",
              "title": "Remittance Information"
            },
            "status": {
              "$ref": "#/$defs/TransactionStatus",
              "description": "Ntry/Sts"
            },
            "value_date": {
              "description": "Ntry/ValDt",
              "format": "date",
              "title": "Value Date",
              "type": "string"
            }
          },
          "required": [
            "entry_reference",
            "amount",
            "currency",
            "credit_debit",
            "status",
            "booking_date",
            "value_date",
            "bank_transaction_code"
          ],
          "title": "AccountEntry",
          "type": "object"
        },
        "CreditDebit": {
          "description": "camt.053 ``CdtDbtInd``.",
          "enum": [
            "CRDT",
            "DBIT"
          ],
          "title": "CreditDebit",
          "type": "string"
        },
        "TransactionStatus": {
          "description": "The dataset's ``transaction_status``. The only source of a payment's status (DATA.md):\na null ``response_code`` is a deliberate defect on about 5% of rows and never means a failure.\nModelled on the pacs.002 status codes (PDNG pending, ACSC settled, RJCT rejected).",
          "enum": [
            "Pending",
            "Approved",
            "Declined",
            "Reversed"
          ],
          "title": "TransactionStatus",
          "type": "string"
        }
      },
      "properties": {
        "result": {
          "items": {
            "$ref": "#/$defs/AccountEntry"
          },
          "title": "Result",
          "type": "array"
        }
      },
      "required": [
        "result"
      ],
      "title": "get_account_entriesOutput",
      "type": "object"
    }
  },
