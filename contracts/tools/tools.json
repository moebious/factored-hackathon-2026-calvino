      "$defs": {
        "CancellationOutcome": {
          "description": "camt.029 outcome of a cancellation request.",
          "enum": [
            "accepted",
            "rejected"
          ],
          "title": "CancellationOutcome",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "A cancellation request (camt.056) and its answer (camt.029).",
      "properties": {
        "message": {
          "title": "Message",
