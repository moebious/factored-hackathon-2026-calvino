{
  "additionalProperties": false,
  "description": "An account or linked-product projection (camt.052 ``Acct`` shape).",
  "properties": {
    "account_id": {
      "description": "Acct/Id; source product id in the cleaned-table adapter",
      "title": "Account Id",
      "type": "string"
    },
    "account_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Acct/Tp",
      "title": "Account Type"
    },
    "balance": {
      "anyOf": [
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,19}0*$)\\d{0,16}\\.\\d{0,2}0*$)",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Bal/Amt",
      "title": "Balance"
    },
    "currency": {
      "anyOf": [
        {
          "description": "ISO 4217 currency code",
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Acct/Ccy",
      "title": "Currency"
    },
    "status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    }
  },
  "required": [
    "account_id"
  ],
  "title": "Account",
  "type": "object"
}
