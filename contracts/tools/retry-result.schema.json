{
  "$defs": {
    "PaymentStatus": {
      "additionalProperties": false,
      "description": "The status of one payment (pacs.002 ``TxInfAndSts``).",
      "properties": {
        "original_reference": {
          "description": "OrgnlTxId",
          "title": "Original Reference",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "StsRsnInf/Rsn",
          "title": "Reason"
        },
        "status": {
          "$ref": "#/$defs/TransactionStatus",
          "description": "TxSts"
        }
      },
      "required": [
        "original_reference",
        "status"
      ],
      "title": "PaymentStatus",
      "type": "object"
    },
    "TransactionStatus": {
      "description": "The dataset's ``transaction_status``. The only source of a payment's status (DATA.md):\na null ``response_code`` is a deliberate defect on about 5% of rows and never means a failure.\nModelled on the pacs.002 status codes (PDNG pending, ACSC settled, RJCT rejected).",
      "enum": [
        "Pending",
        "Approved",
        "Declined",
        "Reversed"
      ],
      "title": "TransactionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The new payment created by retrying a declined one.",
  "properties": {
    "message": {
      "title": "Message",
      "type": "string"
    },
    "new_payment": {
      "$ref": "#/$defs/PaymentStatus"
    },
    "original_reference": {
      "title": "Original Reference",
      "type": "string"
    },
    "simulated": {
      "description": "True when the adapter did not move real money",
      "title": "Simulated",
      "type": "boolean"
    }
  },
  "required": [
    "original_reference",
    "new_payment",
    "simulated",
    "message"
  ],
  "title": "RetryResult",
  "type": "object"
}
