# Keep the Docker build context small: the image only needs src/, policy/,
# playbooks/, prompts/, rubrics/ and the one synthetic fixture below.
.git
.bare
.gitignore
.githooks
.github
.worktrees
.venv
.calvino-data
data
docs
frontend
contracts
reports
scripts
tests/*
!tests/fixtures/
tests/fixtures/*
!tests/fixtures/bank/
tests/fixtures/bank/*
!tests/fixtures/bank/synthetic_bank.json
*.log
*.md
!README.md
